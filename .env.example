DATABASE_URL=sqlite:///./qrtracker.db
SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters
BASE_URL=http://localhost:8000
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running
POSTGRES_PASSWORD=change-me-postgres
ANONYMIZE_IP=true
ENVIRONMENT=development
# Optional local MaxMind GeoLite2 database; no network lookup is made for scans.
GEOIP_DB_PATH=
# Only trust a reverse proxy when the app cannot be reached directly.
TRUST_PROXY_HEADERS=false
